{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/hooks/n5-research-protocol.sh",
            "timeout": 10,
            "statusMessage": "Loading Niagara N5 research protocol..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/hooks/n5-tools.sh",
            "timeout": 10,
            "statusMessage": "Loading Niagara N5 toolbelt card..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/research-protocol.sh",
            "timeout": 10,
            "statusMessage": "Loading Research-SDD protocol..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/retro-gate-stop.sh"
          }
        ]
      }
    ]
  }
}
